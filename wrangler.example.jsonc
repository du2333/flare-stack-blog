// Template for `bun run wrangler:prepare`. Placeholders are replaced from env.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worker-name-placeholder",
  "compatibility_date": "2026-02-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "./src/server.ts",
  "cache": {
    "enabled": true,
  },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "App": { "type": "worker", "cache": { "enabled": true } },
  },
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "routes": [
    {
      "pattern": "DOMAIN_PLACEHOLDER",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "D1_DATABASE_ID",
      "migrations_dir": "migrations",
      // "remote": true
    }
  ],
  "r2_buckets": [
    {
      "bucket_name": "bucket-name-placeholder",
      "binding": "R2",
      // "remote": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "KV_NAMESPACE_ID",
      // "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      }
    ]
  },
  "queues": {
    "producers": [{ "binding": "QUEUE", "queue": "queue-name-placeholder" }],
    "consumers": [
      {
        "queue": "queue-name-placeholder",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "triggers": {
    "crons": ["15 0 * * *"]
  },
  "migrations": [
    {
      "tag": "rate-limiter-v1",
      "new_sqlite_classes": ["RateLimiter"]
    },
    {
      "tag": "password-hasher-v1",
      "new_sqlite_classes": ["PasswordHasher"]
    },
    {
      "tag": "password-hasher-v2",
      "deleted_classes": ["PasswordHasher"]
    }
  ],
  "env": {
    "test": {
      "durable_objects": {
        "bindings": [
          {
            "name": "RATE_LIMITER",
            "class_name": "RateLimiter"
          }
        ]
      },
      "kv_namespaces": [
        {
          "binding": "KV"
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB"
        }
      ],
      "queues": {
        "producers": [{ "binding": "QUEUE", "queue": "queue-name-placeholder" }]
      }
    }
  }
}
