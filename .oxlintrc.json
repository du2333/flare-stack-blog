{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "eslint/no-unused-vars": "off",
    "eslint/no-unused-expressions": "off",
    "unicorn/no-new-array": "off",
    "eslint/no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "sonner",
            "message": "Import `toast` from \"@/lib/toast\": it keeps sonner out of the first load and shows a toast asked for before sonner has loaded."
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    "src/paraglide",
    "src/routeTree.gen.ts",
    ".cloudflare/**",
    "migrations/**",
    "dist/**"
  ],
  "env": {
    "builtin": true
  },
  "options": {
    "typeAware": true
  },
  "overrides": [
    {
      "files": ["src/components/layout/toaster.tsx", "src/lib/toast.ts"],
      "rules": {
        "eslint/no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/routes/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "sonner",
                "message": "Import `toast` from \"@/lib/toast\": it keeps sonner out of the first load and shows a toast asked for before sonner has loaded."
              },
              {
                "name": "zod",
                "message": "A route file is in the first load of every page, and classic zod weighs about 90 KB there. Build the search schema with \"zod/mini\", or import it from a plain module (`*-search.ts`) that does."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/test-utils.ts",
        "tests/**"
      ],
      "rules": {
        "typescript/unbound-method": "off"
      }
    }
  ]
}
