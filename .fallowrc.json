{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["src/server.ts", "src/**/*.test.ts", "scripts/**/*.test.ts"],
  "dynamicallyLoaded": [
    ".release-it.ts",
    "tests/apply-migrations.ts",
    "tests/mocks/tanstack-start-mock.ts"
  ],
  "ignoreExports": [
    {
      "file": "src/lib/orpc/server-client.ts",
      "exports": ["createServerORPCClient"]
    }
  ],
  "duplicates": {
    "ignore": ["src/routeTree.gen.ts"]
  },
  "rules": {
    "unused-dependencies": "warn"
  },
  "usedClassMembers": [
    {
      "extends": "WorkerEntrypoint",
      "members": ["fetch"]
    },
    {
      "extends": "DurableObject",
      "members": ["alarm", "checkLimit", "hash", "verify"]
    }
  ],
  "ignorePatterns": [
    "tmp/**",
    "dist/**",
    ".wrangler/**",
    ".tanstack/**",
    ".output/**",
    ".cache/**",
    "worker-configuration.d.ts"
  ]
}
